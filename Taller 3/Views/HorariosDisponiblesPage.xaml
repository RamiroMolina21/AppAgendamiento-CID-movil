<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Taller_3.ViewModels"
             xmlns:models="clr-namespace:Taller_3.Models"
             x:Class="Taller_3.Views.HorariosDisponiblesPage"
             x:DataType="viewmodels:HorariosDisponiblesViewModel"
             BackgroundColor="#E8F5E9">
    
    <ContentPage.ToolbarItems>
        <ToolbarItem IconImageSource="menu.png" 
                     Command="{Binding LoadDataCommand}"
                     Order="Primary"/>
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Spacing="0">
            <VerticalStackLayout BackgroundColor="#2E7D32" 
                                 Padding="20" 
                                 Spacing="5">
                <Label Text="Horarios Disponibles" 
                       FontSize="24" 
                       FontAttributes="Bold" 
                       TextColor="White"/>
                <Label Text="Reserva un horario disponible para una nueva tutoría" 
                       FontSize="14" 
                       TextColor="White"/>
            </VerticalStackLayout>

            <VerticalStackLayout Padding="20" Spacing="20">
                <VerticalStackLayout Spacing="15">
                    <HorizontalStackLayout Spacing="10">
                        <Image Source="calendar.png" 
                               HeightRequest="24" 
                               WidthRequest="24"/>
                        <Label Text="Horarios Disponibles" 
                               FontSize="18" 
                               FontAttributes="Bold" 
                               TextColor="Black"/>
                        <Label Text="{Binding ContadorTexto}" 
                               FontSize="18" 
                               FontAttributes="Bold" 
                               TextColor="Red"/>
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Spacing="10">
                        <Entry Text="{Binding SearchText}" 
                               Placeholder="Buscar..." 
                               BackgroundColor="White"
                               HorizontalOptions="FillAndExpand"/>
                        <Label Text="{Binding FechaActual, StringFormat='{0:dd/MM/yyyy}'}" 
                               FontSize="14" 
                               TextColor="Black"
                               VerticalOptions="Center"/>
                    </HorizontalStackLayout>

                    <ActivityIndicator IsRunning="{Binding IsLoading}"
                                       IsVisible="{Binding IsLoading}"
                                       Color="#2E7D32"
                                       HorizontalOptions="Center"/>

                    <CollectionView ItemsSource="{Binding GruposHorarios}" 
                                    EmptyView="No hay horarios disponibles.">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:HorarioGrupoItem">
                                <Border StrokeThickness="1" 
                                        Stroke="#E0E0E0" 
                                        BackgroundColor="White" 
                                        Padding="15" 
                                        Margin="0,0,0,10"
                                        StrokeShape="RoundRectangle 5,5,5,5">
                                    <VerticalStackLayout Spacing="10">
                                        <HorizontalStackLayout Spacing="8">
                                            <Label Text="{Binding Titulo}" 
                                                   FontSize="16" 
                                                   FontAttributes="Bold" 
                                                   TextColor="Black"
                                                   HorizontalOptions="FillAndExpand"/>
                                            <Border IsVisible="{Binding EsRecurrente}"
                                                    BackgroundColor="#E8F5E9"
                                                    Stroke="#2E7D32"
                                                    StrokeThickness="1"
                                                    Padding="8,4"
                                                    StrokeShape="RoundRectangle 8,8,8,8">
                                                <Label Text="{Binding EtiquetaRecurrencia}"
                                                       FontSize="11"
                                                       TextColor="#2E7D32"/>
                                            </Border>
                                        </HorizontalStackLayout>

                                        <Label Text="{Binding HorarioTexto, StringFormat='Hora: {0}'}" 
                                               FontSize="14" 
                                               TextColor="#757575"/>
                                        <Label Text="{Binding Espacio}" 
                                               FontSize="14" 
                                               TextColor="#757575"/>

                                        <Label IsVisible="{Binding EsRecurrente, Converter={StaticResource InvertedBoolConverter}}"
                                               Text="{Binding RangoFechas, StringFormat='Fecha: {0}'}" 
                                               FontSize="14" 
                                               TextColor="#757575"/>

                                        <Label IsVisible="{Binding EsRecurrente}"
                                               Text="{Binding RangoFechas, StringFormat='Fechas: {0}'}" 
                                               FontSize="14" 
                                               TextColor="#757575"/>

                                        <Button IsVisible="{Binding EsRecurrente}"
                                                Text="{Binding TextoExpandir}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:HorariosDisponiblesViewModel}}, Path=ToggleExpandCommand}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="#1B5E20"
                                                TextColor="White"
                                                CornerRadius="5"/>

                                        <VerticalStackLayout IsVisible="{Binding IsExpanded}"
                                                             BindableLayout.ItemsSource="{Binding Ocurrencias}"
                                                             Spacing="8">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate x:DataType="models:HorarioResponseDto">
                                                    <Border Stroke="#E8F5E9"
                                                            StrokeThickness="1"
                                                            BackgroundColor="#F1F8E9"
                                                            Padding="10"
                                                            Margin="0,0,0,6"
                                                            StrokeShape="RoundRectangle 4,4,4,4">
                                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                                                <Label Text="{Binding FechaInicio, StringFormat='{0:dddd dd/MM/yyyy}'}"
                                                                       FontSize="13"
                                                                       FontAttributes="Bold"
                                                                       TextColor="#424242"/>
                                                                <Label Text="{Binding HoraInicio, StringFormat='Hora: {0:HH:mm}'}"
                                                                       FontSize="12"
                                                                       TextColor="#757575"/>
                                                            </VerticalStackLayout>
                                                            <Button Grid.Column="1"
                                                                    Text="Agendar"
                                                                    FontSize="12"
                                                                    Padding="12,6"
                                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:HorariosDisponiblesViewModel}}, Path=AgendarTutoriaCommand}"
                                                                    CommandParameter="{Binding .}"
                                                                    BackgroundColor="#2E7D32"
                                                                    TextColor="White"
                                                                    CornerRadius="5"
                                                                    VerticalOptions="Center"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </VerticalStackLayout>

                                        <Button IsVisible="{Binding EsRecurrente, Converter={StaticResource InvertedBoolConverter}}"
                                                Text="Agendar Tutoría" 
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:HorariosDisponiblesViewModel}}, Path=AgendarTutoriaCommand}"
                                                CommandParameter="{Binding PrimeraOcurrencia}"
                                                BackgroundColor="#2E7D32" 
                                                TextColor="White"
                                                CornerRadius="5"/>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
